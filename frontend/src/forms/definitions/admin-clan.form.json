{
  "id": "admin-clan",
  "titleKey": "admin.form.new.members",
  "submitKey": "form.submit",
  "fields": [
    {
      "name": "firstName",
      "type": "text",
      "labelKey": "admin.field.firstName",
      "required": true,
      "maxLength": 60
    },
    {
      "name": "lastName",
      "type": "text",
      "labelKey": "admin.field.lastName",
      "required": true,
      "maxLength": 60
    },
    {
      "name": "gender",
      "type": "select",
      "labelKey": "admin.field.gender",
      "required": true,
      "options": [
        {
          "value": "M",
          "labelKey": "admin.value.genderM"
        },
        {
          "value": "F",
          "labelKey": "admin.value.genderF"
        }
      ]
    },
    {
      "name": "ageBand",
      "type": "select",
      "labelKey": "admin.field.ageBand",
      "required": true,
      "options": [
        {
          "value": "24-",
          "labelKey": "admin.value.ageBand24"
        },
        {
          "value": "25-39",
          "labelKey": "admin.value.ageBand2539"
        },
        {
          "value": "40-54",
          "labelKey": "admin.value.ageBand4054"
        },
        {
          "value": "55+",
          "labelKey": "admin.value.ageBand55"
        }
      ]
    },
    {
      "name": "city",
      "type": "text",
      "labelKey": "admin.field.city",
      "required": true,
      "maxLength": 80
    },
    {
      "name": "country",
      "type": "country",
      "labelKey": "admin.field.country",
      "required": true
    },
    {
      "name": "firstSeason",
      "type": "number",
      "labelKey": "admin.field.firstSeason",
      "required": true,
      "min": 2014,
      "max": 2027
    },
    {
      "name": "firstSeason2027",
      "type": "checkbox",
      "labelKey": "admin.field.firstSeason2027"
    },
    {
      "name": "membershipBasis",
      "type": "select",
      "labelKey": "admin.basis",
      "required": true,
      "options": [
        {
          "value": "payment",
          "labelKey": "admin.basisValue.payment"
        },
        {
          "value": "feeExempt",
          "labelKey": "admin.basisValue.feeExempt"
        }
      ]
    }
  ]
}
