{
  "id": "admin-znacka",
  "titleKey": "admin.form.new.badges",
  "submitKey": "form.submit",
  "fields": [
    {
      "name": "name",
      "type": "text",
      "labelKey": "admin.field.badgeName",
      "required": true,
      "maxLength": 60
    },
    {
      "name": "description",
      "type": "textarea",
      "labelKey": "admin.field.description",
      "hintKey": "admin.hint.description",
      "maxLength": 400
    },
    {
      "name": "label",
      "type": "text",
      "labelKey": "admin.field.badgeLabel",
      "hintKey": "admin.hint.badgeLabel",
      "maxLength": 16
    },
    {
      "name": "kind",
      "type": "select",
      "labelKey": "badges.kindLabel",
      "hintKey": "admin.hint.kind",
      "required": true,
      "options": [
        { "value": "raceCount", "labelKey": "badges.kind.raceCount" },
        { "value": "marathonCount", "labelKey": "badges.kind.marathonCount" },
        { "value": "halfCount", "labelKey": "badges.kind.halfCount" },
        { "value": "longCount", "labelKey": "badges.kind.longCount" },
        { "value": "shortCount", "labelKey": "badges.kind.shortCount" },
        { "value": "ultraCount", "labelKey": "badges.kind.ultraCount" },
        { "value": "totalKm", "labelKey": "badges.kind.totalKm" },
        { "value": "totalAscent", "labelKey": "badges.kind.totalAscent" },
        { "value": "totalDescent", "labelKey": "badges.kind.totalDescent" },
        { "value": "totalTime", "labelKey": "badges.kind.totalTime" },
        { "value": "points", "labelKey": "badges.kind.points" },
        { "value": "countryCount", "labelKey": "badges.kind.countryCount" },
        { "value": "seasonCount", "labelKey": "badges.kind.seasonCount" },
        { "value": "bestRacePoints", "labelKey": "badges.kind.bestRacePoints" },
        { "value": "bestRaceKm", "labelKey": "badges.kind.bestRaceKm" },
        { "value": "bestRaceAscent", "labelKey": "badges.kind.bestRaceAscent" }
      ]
    },
    {
      "name": "value",
      "type": "number",
      "labelKey": "badges.valueLabel",
      "hintKey": "admin.hint.badgeValue",
      "required": true,
      "min": 1,
      "max": 100000
    },
    {
      "name": "from",
      "type": "date",
      "labelKey": "badges.from"
    },
    {
      "name": "to",
      "type": "date",
      "labelKey": "badges.to",
      "hintKey": "admin.hint.badgePeriod"
    }
  ]
}
