    {
      "name": "heading",
      "type": "text",
      "labelKey": "admin.field.sectionHeading",
      "maxLength": 120
    },
    {
      "name": "body",
      "type": "textarea",
      "labelKey": "admin.field.sectionBody",
      "hintKey": "admin.hint.sectionBody",
      "maxLength": 8000
    }
  ]
}
