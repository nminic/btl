{
  "id": "admin-liga",
  "titleKey": "admin.form.new.leagues",
  "submitKey": "form.submit",
  "fields": [
    {
      "name": "name",
      "type": "text",
      "labelKey": "admin.field.leagueName",
      "required": true,
      "maxLength": 80
    },
    {
      "name": "slug",
      "type": "text",
      "labelKey": "admin.address",
      "required": true,
      "maxLength": 60,
      "pattern": "^[a-z0-9-]+$"
    },
    {
      "name": "season",
      "type": "number",
      "labelKey": "rankings.season",
      "required": true,
      "min": 2014,
      "max": 2100
    },
    {
      "name": "groupsByCategory",
      "type": "checkbox",
      "labelKey": "admin.byCategory"
    },
    {
      "name": "rules",
      "type": "textarea",
      "labelKey": "leagues.rules",
      "maxLength": 4000
    },
    {
      "name": "prizes",
      "type": "textarea",
      "labelKey": "leagues.prizes",
      "maxLength": 4000
    }
  ]
}
