{
  "id": "registracija",
  "titleKey": "registration.title",
  "submitKey": "registration.submit",
  "fields": [
    {
      "name": "firstName",
      "type": "text",
      "labelKey": "registration.firstName",
      "required": true,
      "maxLength": 60
    },
    {
      "name": "lastName",
      "type": "text",
      "labelKey": "registration.lastName",
      "required": true,
      "maxLength": 60
    },
    {
      "name": "email",
      "type": "email",
      "labelKey": "registration.email",
      "hintKey": "registration.emailHint",
      "required": true
    },
    {
      "name": "password",
      "type": "password",
      "labelKey": "registration.password",
      "hintKey": "registration.passwordHint",
      "required": true,
      "minLength": 10
    },
    {
      "name": "passwordRepeat",
      "type": "password",
      "labelKey": "registration.passwordRepeat",
      "required": true,
      "matches": "password"
    },
    {
      "name": "birthDate",
      "type": "date",
      "labelKey": "registration.birthDate",
      "hintKey": "registration.birthDateHint",
      "required": true
    },
    {
      "name": "parentConsent",
      "type": "text",
      "labelKey": "registration.parentConsent",
      "hintKey": "registration.parentConsentHint",
      "required": true,
      "maxLength": 120,
      "showWhenYoungerThan": { "field": "birthDate", "years": 16 }
    },
    {
      "name": "gender",
      "type": "select",
      "labelKey": "registration.gender",
      "required": true,
      "options": [
        { "value": "M", "labelKey": "registration.genderMale" },
        { "value": "F", "labelKey": "registration.genderFemale" }
      ]
    },
    {
      "name": "city",
      "type": "text",
      "labelKey": "registration.city",
      "required": true,
      "maxLength": 80
    },
    {
      "name": "country",
      "type": "country",
      "labelKey": "registration.country",
      "hintKey": "registration.countryHint",
      "required": true
    },
    {
      "name": "shirtSize",
      "type": "select",
      "labelKey": "registration.shirtSize",
      "hintKey": "registration.shirtSizeHint",
      "required": true,
      "options": [
        { "value": "XS", "labelKey": "shirt.XS" },
        { "value": "S", "labelKey": "shirt.S" },
        { "value": "M", "labelKey": "shirt.M" },
        { "value": "L", "labelKey": "shirt.L" },
        { "value": "XL", "labelKey": "shirt.XL" },
        { "value": "XXL", "labelKey": "shirt.XXL" },
        { "value": "XXXL", "labelKey": "shirt.XXXL" }
      ]
    },
    {
      "name": "firstSeason",
      "type": "checkbox",
      "labelKey": "registration.firstSeason",
      "hintKey": "registration.firstSeasonHint"
    },
    {
      "name": "healthStatement",
      "type": "checkbox",
      "labelKey": "registration.healthStatement",
      "hintKey": "registration.healthStatementHint",
      "required": true
    }
  ]
}
