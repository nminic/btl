{
  "id": "registracija",
  "titleKey": "registration.title",
  "submitKey": "registration.submit",
  "fields": [
    {
      "name": "firstName",
      "type": "text",
      "labelKey": "registration.firstName",
      "required": true,
      "maxLength": 60,
      "row": 1
    },
    {
      "name": "lastName",
      "type": "text",
      "labelKey": "registration.lastName",
      "required": true,
      "maxLength": 60,
      "row": 1
    },
    {
      "name": "gender",
      "type": "choice",
      "labelKey": "registration.gender",
      "hintKey": "registration.genderHint",
      "required": true,
      "row": 1,
      "options": [
        {
          "value": "M",
          "labelKey": "registration.genderMale"
        },
        {
          "value": "F",
          "labelKey": "registration.genderFemale"
        }
      ]
    },
    {
      "name": "birthDate",
      "type": "date",
      "labelKey": "registration.birthDate",
      "hintKey": "registration.birthDateHint",
      "required": true,
      "row": 1
    },
    {
      "name": "parentConsent",
      "type": "text",
      "labelKey": "registration.parentConsent",
      "hintKey": "registration.parentConsentHint",
      "required": true,
      "maxLength": 120,
      "showWhenYoungerThan": {
        "field": "birthDate",
        "years": 16
      }
    },
    {
      "name": "email",
      "type": "email",
      "labelKey": "registration.email",
      "hintKey": "registration.emailHint",
      "required": true,
      "row": 2
    },
    {
      "name": "password",
      "type": "password",
      "labelKey": "registration.password",
      "hintKey": "registration.passwordHint",
      "required": true,
      "minLength": 10,
      "row": 2
    },
    {
      "name": "passwordRepeat",
      "type": "password",
      "labelKey": "registration.passwordRepeat",
      "required": true,
      "matches": "password",
      "row": 2
    },
    {
      "name": "address",
      "type": "text",
      "labelKey": "registration.address",
      "hintKey": "registration.addressHint",
      "required": true,
      "maxLength": 120,
      "row": 3
    },
    {
      "name": "city",
      "type": "place",
      "labelKey": "registration.city",
      "hintKey": "registration.cityHint",
      "required": true,
      "maxLength": 80,
      "row": 3
    },
    {
      "name": "firstSeason2027",
      "type": "choice",
      "labelKey": "registration.category",
      "hintKey": "registration.categoryHint",
      "required": true,
      "row": 4,
      "options": [
        {
          "value": "yes",
          "labelKey": "registration.categoryFirstSeason"
        },
        {
          "value": "no",
          "labelKey": "registration.categoryByAge"
        }
      ]
    },
    {
      "name": "shirtSize",
      "type": "select",
      "labelKey": "registration.shirtSize",
      "hintKey": "registration.shirtSizeHint",
      "required": true,
      "row": 4,
      "options": [
        {
          "value": "XS",
          "labelKey": "shirt.XS"
        },
        {
          "value": "S",
          "labelKey": "shirt.S"
        },
        {
          "value": "M",
          "labelKey": "shirt.M"
        },
        {
          "value": "L",
          "labelKey": "shirt.L"
        },
        {
          "value": "XL",
          "labelKey": "shirt.XL"
        },
        {
          "value": "XXL",
          "labelKey": "shirt.XXL"
        },
        {
          "value": "XXXL",
          "labelKey": "shirt.XXXL"
        }
      ]
    },
    {
      "name": "photo",
      "type": "photo",
      "labelKey": "registration.photo",
      "hintKey": "registration.photoHint",
      "required": true,
      "row": 5
    },
    {
      "name": "bio",
      "type": "textarea",
      "labelKey": "profile.bio",
      "hintKey": "registration.bioHint",
      "required": true,
      "maxLength": 360,
      "row": 5
    },
    {
      "name": "healthStatement",
      "type": "checkbox",
      "labelKey": "registration.healthStatement",
      "linkKey": "registration.healthStatementLink",
      "linkTo": "pravilnik",
      "required": true,
      "hintKey": "registration.healthStatementHint"
    }
  ]
}
