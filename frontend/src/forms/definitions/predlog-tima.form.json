{
  "id": "predlog-tima",
  "titleKey": "teams.proposeTitle",
  "submitKey": "teams.proposeSubmit",
  "fields": [
    {
      "name": "name",
      "type": "text",
      "labelKey": "admin.field.teamName",
      "required": true,
      "maxLength": 60
    },
    {
      "name": "city",
      "type": "place",
      "labelKey": "admin.field.city",
      "required": true,
      "maxLength": 80
    },
    {
      "name": "bio",
      "type": "textarea",
      "labelKey": "admin.field.teamBio",
      "maxLength": 360
    },
    {
      "name": "link",
      "type": "text",
      "labelKey": "admin.field.teamLink",
      "pattern": "^https?:\\/\\/[^\\s]+$",
      "maxLength": 500
    }
  ]
}
