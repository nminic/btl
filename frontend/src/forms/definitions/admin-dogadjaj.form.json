{
  "id": "admin-dogadjaj",
  "titleKey": "admin.form.new.events",
  "submitKey": "form.submit",
  "columns": 3,
  "fields": [
    {
      "name": "name",
      "type": "text",
      "labelKey": "admin.field.eventName",
      "required": true,
      "maxLength": 120,
      "row": 1
    },
    {
      "name": "kind",
      "type": "select",
      "labelKey": "admin.field.kind",
      "required": true,
      "options": [
        {
          "value": "race",
          "labelKey": "event.kind.race"
        },
        {
          "value": "training",
          "labelKey": "event.kind.training"
        },
        {
          "value": "gathering",
          "labelKey": "event.kind.gathering"
        }
      ],
      "row": 1
    },
    {
      "name": "date",
      "type": "date",
      "labelKey": "admin.field.date",
      "required": true,
      "row": 2
    },
    {
      "name": "featured",
      "type": "select",
      "labelKey": "admin.field.featured",
      "required": true,
      "options": [
        {
          "value": "no",
          "labelKey": "form.no"
        },
        {
          "value": "yes",
          "labelKey": "form.yes"
        }
      ],
      "row": 2
    },
    {
      "name": "city",
      "type": "place",
      "labelKey": "admin.field.city",
      "required": true,
      "maxLength": 80,
      "row": 3
    },
    {
      "name": "description",
      "type": "textarea",
      "labelKey": "admin.field.eventDescription",
      "maxLength": 600
    },
    {
      "name": "link",
      "type": "text",
      "labelKey": "admin.field.eventLink",
      "pattern": "^https?:\\/\\/[^\\s]+$",
      "maxLength": 500
    }
  ]
}
