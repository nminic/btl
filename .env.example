# Copy to .env and set real values. .env is NEVER committed.

# Local development, read by docker-compose.yml in this directory.
POSTGRES_DB=btl
POSTGRES_USER=btl
POSTGRES_PASSWORD=change-me

# QA, read by deploy/compose.qa.yml. Copy these three into deploy/.env on the
# QA host, not into the .env next to this file: Compose reads the .env of the
# directory the deploy command runs from, and that command runs from deploy/.
#
# The names are prefixed so that QA and production can never end up on the same
# database, role or password by someone copying one file over the other. Both
# stacks live on the same host, in two checkouts, /opt/btl and /opt/btl-qa.
QA_POSTGRES_DB=btl_qa
QA_POSTGRES_USER=btl_qa
QA_POSTGRES_PASSWORD=change-me

# MAIL, read by deploy/compose.qa.yml from the same deploy/.env as the three
# above. The relay is Brevo, port 587 with STARTTLS (ADL-posta, decision of
# 12.09.2026).
#
# The key is generated in the Brevo panel under SMTP & API, is shown EXACTLY ONCE
# when it is created, and belongs in the owner's password manager. It never goes
# into this file, never into the repository, and nobody has to read it out loud to
# anybody: it is typed straight into deploy/.env on the host.
#
# With these unset the portal still starts and still serves; what fails is the
# moment somebody asks for a message to go, and it fails out loud.
QA_MAIL_HOST=smtp-relay.brevo.com
QA_MAIL_PORT=587
QA_MAIL_USERNAME=change-me
QA_MAIL_PASSWORD=change-me

# PRODUCTION, read by deploy/compose.prod.yml. Copy these into /opt/btl/deploy/.env
# on the host, the same way the QA ones go into /opt/btl-qa/deploy/.env. The two
# files are never the same file: production runs out of /opt/btl and QA out of
# /opt/btl-qa, and the PROD_ prefix is what keeps one from being pasted over the
# other on a host that carries both.
#
# PROD_POSTGRES_PASSWORD has no default in the compose file. With it unset Compose
# refuses to do anything and names the variable, rather than starting the
# production database without a password. The other two do have defaults, btl and
# btl, so they are here to be changed rather than to be required.
PROD_POSTGRES_DB=btl
PROD_POSTGRES_USER=btl
PROD_POSTGRES_PASSWORD=change-me

# AND PRODUCTION MAIL, from that same /opt/btl/deploy/.env. Brevo again, port 587
# with STARTTLS required (ADL-posta, decision of 12.09.2026).
#
# It is a SEPARATE key from the QA one, generated in the Brevo panel the same way:
# shown exactly once, kept in the owner's password manager, typed straight into the
# .env on the host. Sharing one key between the two stacks would mean a key leaked
# from QA sends mail as the real portal.
#
# Unset, the public site still comes up and still serves every page; only sending
# fails, and it fails out loud to whoever asked for the message.
PROD_MAIL_HOST=smtp-relay.brevo.com
PROD_MAIL_PORT=587
PROD_MAIL_USERNAME=change-me
PROD_MAIL_PASSWORD=change-me
