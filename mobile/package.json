{
  "name": "btl-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "expo": "58.1.0",
    "expo-localization": "58.0.5",
    "expo-status-bar": "58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.3",
    "jest": "30.5.2",
    "jest-expo": "58.0.16",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "index.ts",
      "App.tsx",
      "src/**/*.{ts,tsx}",
      "modules/btl-sensors/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  }
}
